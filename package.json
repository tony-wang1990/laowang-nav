{
  "name": "laowang-nav",
  "version": "1.2.1-fix",
  "license": "MIT",
  "main": "server",
  "author": "LaoWang",
  "repository": {
    "type": "git",
    "url": "https://github.com/tony-wang1990/laowang-nav"
  },
  "description": "A modern, responsive, and highly customizable dashboard for your personal server. Built for you by LaoWang.",
  "scripts": {
    "start": "node server",
    "dev": "cross-env NODE_OPTIONS=\"--openssl-legacy-provider --require ./scripts/node-crypto-polyfill.js\" vue-cli-service serve",
    "build": "cross-env NODE_OPTIONS=\"--openssl-legacy-provider --require ./scripts/node-crypto-polyfill.js\" vue-cli-service build --no-module",
    "lint": "eslint \"src/**/*.{js,vue}\" \"tests/**/*.js\"",
    "pm2-start": "npx pm2 start server.js",
    "build-watch": "cross-env NODE_OPTIONS=\"--openssl-legacy-provider --require ./scripts/node-crypto-polyfill.js\" vue-cli-service build --watch --mode production --no-module",
    "build-and-start": "cross-env NODE_OPTIONS=\"--openssl-legacy-provider --require ./scripts/node-crypto-polyfill.js\" npm-run-all --parallel build start",
    "validate-config": "node services/config-validator",
    "health-check": "node services/healthcheck",
    "dependency-audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@formschema/native": "^2.0.0-beta.6",
    "@sentry/tracing": "^7.120.4",
    "@sentry/vue": "^7.120.4",
    "ajv": "^8.20.0",
    "axios": "^1.18.1",
    "connect-history-api-fallback": "^1.6.0",
    "crypto-js": "^4.2.0",
    "express": "^4.22.2",
    "express-basic-auth": "^1.2.1",
    "frappe-charts": "^1.6.2",
    "js-yaml": "^5.2.1",
    "keycloak-js": "^20.0.3",
    "oidc-client-ts": "^3.0.1",
    "register-service-worker": "^1.7.2",
    "remedial": "^1.0.8",
    "rss-parser": "3.13.0",
    "rsup-progress": "^3.2.0",
    "simple-icons": "^14.4.0",
    "v-jsoneditor": "^1.4.5",
    "v-tooltip": "^2.1.3",
    "vue": "^2.7.0",
    "vue-i18n": "^8.27.2",
    "vue-js-modal": "^2.0.1",
    "vue-json-tree-view": "^2.1.6",
    "vue-material-tabs": "0.1.5",
    "vue-router": "^3.5.3",
    "vue-select": "^3.20.2",
    "vue-swatches": "^2.1.1",
    "vue-toasted": "^1.1.28",
    "vuex": "^3.6.2"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@babel/eslint-parser": "^7.29.7",
    "@vue/cli-plugin-babel": "^5.0.9",
    "@vue/cli-plugin-pwa": "^5.0.9",
    "@vue/cli-service": "^5.0.9",
    "@vue/eslint-config-standard": "^8.0.1",
    "copy-webpack-plugin": "13.0.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-vue": "^9.33.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.16",
    "sass": "1.69.7",
    "sass-loader": "^10.5.2",
    "vue-cli-plugin-yaml": "^1.0.2",
    "vue-svg-loader": "0.12.0",
    "vue-template-compiler": "^2.7.0"
  },
  "engines": {
    "node": ">=18.12.0 <21.6.2"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "@vue/standard",
      "airbnb-base"
    ],
    "rules": {
      "no-console": "off",
      "no-debugger": "off",
      "import/no-unresolved": "off",
      "import/extensions": "off",
      "arrow-parens": 0,
      "no-else-return": 0,
      "function-paren-newline": "off",
      "prefer-regex-literals": "off",
      "vue/multi-word-component-names": "off",
      "vue/no-reserved-component-names": "off"
    },
    "parserOptions": {
      "parser": "@babel/eslint-parser"
    }
  },
  "babel": {
    "presets": [
      "@vue/app",
      "@babel/preset-env"
    ]
  },
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ],
  "overrides": {
    "@babel/runtime": "^7.29.7",
    "lodash": "^4.18.1",
    "nanoid": "^3.3.15",
    "nth-check": "^2.1.1",
    "postcss": "^8.5.16",
    "serialize-javascript": "^7.0.5",
    "uuid": "^11.1.1",
    "webpack-dev-server": "^5.2.5",
    "jsoneditor": {
      "ajv": "^6.15.0"
    }
  }
}
